# --- required ---
# from @BotFather
TELEGRAM_BOT_TOKEN=
# openai | anthropic
LLM_PROVIDER=openai
# platform.openai.com/api-keys   (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
# console.anthropic.com          (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# --- agent ---
# empty = gpt-5.5 (openai) / claude-opus-5-5 (anthropic)
LLM_MODEL=
# low | medium | high | xhigh | max; empty for models without reasoning
LLM_EFFORT=medium
# anthropic only: server-side refusal fallback; "off" to disable
LLM_FALLBACKS=default
AGENT_MAX_ITERATIONS=6
# last N messages kept per chat (in memory)
HISTORY_MESSAGES=10
# agent experiments (🔬 Досліди, 🔧 explanations) per user per day; the game is unlimited
DAILY_LIMIT=20
# comma-separated Telegram user ids without the limit
ADMIN_IDS=
SIM_TIMEOUT_MS=45000
# signal animation render; on timeout the bot sends only the static PNG
ANIMATION_TIMEOUT_MS=20000
AGENT_TIMEOUT_MS=120000

# --- sim-service (docker-compose) ---
# threads per simulation (= vCPU)
SIM_THREADS=4
# synaptic events per request before a runaway run is cut short
SIM_MAX_OPS=200000000
# simulations at a time
SIM_CONCURRENCY=1
